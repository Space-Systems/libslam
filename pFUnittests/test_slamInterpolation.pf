                0.000000,0.000000,0.000000,0.000000,0.000000/)

        vx_vals = (/0.000000,-0.381524,-0.757151,-1.121075,-1.467670,&
            -1.791579,-2.087795,-2.351740,-2.579333,-2.767058,&
